<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="45" android:startColor="#050608" android:centerColor="#11151C" android:endColor="#020304" />
        </shape>
    </item>
    <item android:gravity="top|start" android:width="170dp" android:height="170dp">
        <shape android:shape="rectangle"><solid android:color="#00000000"/><stroke android:width="1dp" android:color="#20FFFFFF"/><corners android:radius="8dp"/></shape>
    </item>
    <item android:gravity="bottom|end" android:width="230dp" android:height="230dp">
        <shape android:shape="rectangle"><solid android:color="#00000000"/><stroke android:width="1dp" android:color="#16FFFFFF"/><corners android:radius="10dp"/></shape>
    </item>
    <item android:gravity="center|start" android:width="92dp" android:height="92dp">
        <shape android:shape="rectangle"><solid android:color="#08000000"/><stroke android:width="1dp" android:color="#18FFFFFF"/><corners android:radius="6dp"/></shape>
    </item>
    <item android:gravity="top|end" android:width="76dp" android:height="76dp">
        <shape android:shape="rectangle"><solid android:color="#08000000"/><stroke android:width="1dp" android:color="#20FFFFFF"/><corners android:radius="6dp"/></shape>
    </item>
    <item android:gravity="bottom|start" android:width="112dp" android:height="112dp">
        <shape android:shape="rectangle"><solid android:color="#08000000"/><stroke android:width="1dp" android:color="#18FFFFFF"/><corners android:radius="6dp"/></shape>
    </item>
</layer-list>